{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Yarp": {
    "Routes": {
      "devices": {
        "ClusterId": "devices",
        "CorsPolicy": "Frontend",
        "Match": {
          "Path": "/app/devices/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/app/devices/{**catch-all}" }
        ]
      },
      "websocket": {
        "ClusterId": "websocket",
        "Match": {
          "Path": "/ws/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/ws/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "devices": {
        "Destinations": {
          "device1": {
            "Address": "http://device-service:5000/"
          }
        }
      },
      "websocket": {
        "Destinations": {
          "websocket1": {
            "Address": "ws://websocket-service:5000/"
          }
        }
      }
    }
  }
}