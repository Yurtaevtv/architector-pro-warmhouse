{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Yarp": {
    "Routes": {
      "device-service-route": {
        "ClusterId": "device-service-cluster",
        "Match": {
          "Path": "/api/devices/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/{**catch-all}" }
        ],
        "Metadata": {
          "Description": "Device management service"
        }
      },
      "scenario-service-route": {
        "ClusterId": "scenario-service-cluster",
        "Match": {
          "Path": "/api/scenarios/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/{**catch-all}" }
        ]
      },
      "websocket-service-route": {
        "ClusterId": "websocket-service-cluster",
        "Match": {
          "Path": "/ws/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/{**catch-all}" }
        ],
        "Metadata": {
          "WebSocket": true
        }
      },
      "health-route": {
        "ClusterId": "health-cluster",
        "Match": {
          "Path": "/health/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "device-service-cluster": {
        "Destinations": {
          "device-service-1": {
            "Address": "http://localmac:7001/",
            "Health": "http://localmac:7001/health"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:02:00"
          }
        },
        "LoadBalancingPolicy": "RoundRobin",
        "SessionAffinity": {
          "Enabled": false
        }
      },
      "scenario-service-cluster": {
        "Destinations": {
          "scenario-service-1": {
            "Address": "http://scenario-service:5002/",
            "Health": "http://scenario-service:5002/health"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Path": "/health"
          }
        }
      },
      "websocket-service-cluster": {
        "Destinations": {
          "websocket-service-1": {
            "Address": "http://localhost:5003/",
            "Health": "http://localhost:5003/health"
          }
        }
      }
    }
  },
  "RateLimiting": {
    "FixedWindow": {
      "PermitLimit": 100,
      "Window": 60,
      "QueueLimit": 10
    }
  }
}