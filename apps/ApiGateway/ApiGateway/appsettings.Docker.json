{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "RouteConfig": {
    "Routes": {
      "devices": {
        "ClusterId": "devices",
        "Match": {
          "Path": "/api/devices/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/{**catch-all}" }
        ]
      },
      "scenarios": {
        "ClusterId": "scenarios",
        "Match": {
          "Path": "/api/scenarios/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/{**catch-all}" }
        ]
      },
      "websocket": {
        "ClusterId": "websocket",
        "Match": {
          "Path": "/ws/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "devices": {
        "Destinations": {
          "device1": {
            "Address": "http://device-service:5001/"
          }
        }
      },
      "scenarios": {
        "Destinations": {
          "scenario1": {
            "Address": "http://scenario-service:5002/"
          }
        }
      },
      "websocket": {
        "Destinations": {
          "websocket1": {
            "Address": "http://websocket-service:5003/"
          }
        }
      }
    }
  }
}