@startuml
title Диаграмма компонентов Integration Service

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

Container(integration_service, "Integration Service", ".NET 8", "Интеграция с устройствами партнеров")

Container_Boundary(integration_service, "Integration Service") {
    Component(device_handler, "DeviceHandler", "Protocol Handler", "Обработка API устройств")
    
    Component(command_event_consumer, "CommandEventConsumer", "Background Service", "Потребление команд из Message Bus")
    Component(telemetry_event_publisher, "TelemetryEventPublisher", "Integration Events", "Публикация телеметрии")
    
    Component(command_processor, "CommandProcessor", "Domain Service", "Выполнение входящей команды")
    Component(telemetry_processor, "TelemetryProcessor", "Domain Service", "Обработка входящей телеметрии")
}

Container(message_bus, "Message Bus", "Kafka")
System_Ext(partner_devices, "Устройства партнеров")

Rel(command_processor, device_handler, "Трансляция команд/телеmeтрии")

Rel(telemetry_processor, telemetry_event_publisher, "Публикация событий телеметрии")
Rel(command_event_consumer, command_processor, "Передача команд устройствам")

Rel(telemetry_event_publisher, message_bus, "Публикация телеметрии", "Kafka Producer")
Rel(message_bus, command_event_consumer, "Получение команд", "Kafka Consumer")

Rel(device_handler, partner_devices, "HTTP команды/события", "REST")
Rel(partner_devices, telemetry_processor, "Telemetry", "SomeProtocol")

@enduml