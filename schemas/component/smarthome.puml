@startuml

title Диаграмма контейнеров микросервисного решения для системы Smart home

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml


Person(User, "User", "Smarthome user")
System(SmartHome, "Smart home", "Smart home system control")
System_Ext(Device, "Device", "Home device")

Container_Boundary(SmartHome, "Smart home system control") {
    Container(WebApp, "Web Application", ".net, vue", "Handles user interactions"){
        Component(AuthController, "AuthController", "Handles authentication and authorization")
        Component(AppDeviceController, "AppDeviceController", "")
        Component(AppProgramController, "AppProgramController", "")
        Component(AppServiceLayer, "AppServiceLayer", "")
    }
    Container(DeviceService, "Device service", ".net", "Interacts with devices"){
        Component(DeviceController, "DeviceController", "")
        Component(MetricController, "MetricController", "")
        Component(DeviceServiceLayer, "DeviceServiceLayer", "")
        Component(DeviceRepository, "DeviceRepository", "")
    }
    Container(ProgramService, "Program service", ".net", "Device`s state machine"){
        Component(ProgramContoller, "ProgramContoller", "")
        Component(ProgramServiceLayer, "ProgramServiceLayer", "")
        Component(ProgramBackgroundLayer, "BackgroundLayer", "")
        Component(ProgramRepository, "ProgramRepository", "")
    }
    Container(DeviceDatabase, "Device database", "PostgreSql", "Store device`s info, states, programs")
    Container(ProgramDatabase, "Program database", "PostgreSql", "Store state machine, current states, programs")
}


Rel(AuthController, AppServiceLayer, "")
Rel(AppDeviceController, AppServiceLayer, "")
Rel(AppProgramController, AppServiceLayer, "")

Rel(AppServiceLayer, DeviceController, "")
Rel(AppServiceLayer, MetricController, "")
Rel(AppServiceLayer, ProgramContoller, "")

Rel(DeviceController, DeviceServiceLayer, "")
Rel(MetricController, DeviceServiceLayer, "")
Rel(DeviceServiceLayer, DeviceRepository, "")
Rel(DeviceServiceLayer, Device, "")
Rel(DeviceRepository, DeviceDatabase, "")

Rel(ProgramContoller, ProgramServiceLayer, "")
Rel(ProgramBackgroundLayer, ProgramServiceLayer, "")
Rel(ProgramServiceLayer, ProgramRepository, "")
Rel(ProgramServiceLayer, DeviceController, "")
Rel(ProgramServiceLayer, MetricController, "")
Rel(ProgramRepository, ProgramDatabase, "")

Rel(User, WebApp,  "Uses smarthome web application")
' Rel(WebApp, DeviceService,  "Request device`s info")
' Rel(WebApp, ProgramService,  "Request program to control devices")
' Rel(DeviceService, DeviceDatabase,  "Read/Write device`s info")
' Rel(ProgramService, ProgramDatabase,  "Read/Write program/state info")
' Rel(ProgramService, DeviceService,  "Control`s device`s by program")
' Rel(DeviceService, device,  "Read metrics/ use device")


@enduml